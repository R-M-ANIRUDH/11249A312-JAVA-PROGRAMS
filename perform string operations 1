class DepartmentCheck {
    public static void main(String[] args) {
        String emp1 = "Alice - Sales";
        String emp2 = "Bob - Sales";

        
        String dept1 = emp1.split("-")[1].trim();
        String dept2 = emp2.split("-")[1].trim();

       
        if (dept1.equalsIgnoreCase(dept2)) {
            System.out.println("Both employees work in the SAME department: " + dept1);
        } else {
            System.out.println("Employees work in DIFFERENT departments.");
        }
    }
}
